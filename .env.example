# --- Server ---
PORT=5000
NODE_ENV=development
# Frontend URL(s) allowed to call this API (comma separated, no trailing slash)
CLIENT_URL=http://localhost:5173

# --- Database (admins, members, plans — everything lives here) ---
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/fitzone

# --- Auth (secret used to sign login tokens; use a long random string) ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Cloudinary (member photos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email receipts (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FitZone <you@example.com>"

# NOTE: admin usernames / passwords are NOT stored here anymore.
# Create the first owner with:  npm run create-admin

# --- Receipt PDF header (optional) ---
GYM_NAME=FitZone
GYM_ADDRESS=
GYM_PHONE=
